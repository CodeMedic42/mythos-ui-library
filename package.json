{
  "name": "@mythos/ui-library",
  "version": "1.3.0",
  "description": "Small React component library: layout, inputs and date selection",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/CodeMedic42/mythos-ui-library.git",
  "homepage": "https://github.com/CodeMedic42/mythos-ui-library#readme",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "rollup -c && npm run build:css",
    "test": "vitest run",
    "lint": "eslint src && stylelint 'src/**/*.scss'",
    "format": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "build:css": "sass --no-source-map src/styles/index.scss dist/styles.css"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/dom": "^10.3.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.5.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.18.0",
    "sass": "^1.77.0",
    "stylelint": "^16.6.0",
    "tslib": "^2.6.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
